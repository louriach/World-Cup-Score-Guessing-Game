# Environment & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
secrets.json

# Supabase local config (contains local DB credentials)
supabase/.temp/
supabase/config.toml.local

# Flutter
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.iml
.packages
pubspec.lock

